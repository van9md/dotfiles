#!/usr/bin/env bash
set -uo pipefail

NOTES_DIR="${NOTES_DIR:-$HOME/notes}"
EDITOR="${EDITOR:-nvim}"

mkdir -p "$NOTES_DIR"
cd "$NOTES_DIR" || exit 1

# gio trash is reversible; plain rm is the fallback
if command -v gio >/dev/null 2>&1; then
  DELETE_CMD="gio trash --"
else
  DELETE_CMD="rm -f --"
fi

# newest first
LIST_CMD="find . -type f -name '*.md' -printf '%T@\t%P\n' | sort -rn | cut -f2-"
RG_CMD="rg --line-number --no-heading --color=always --smart-case --glob '*.md'"

PREVIEW_FILE='bat --color=always --style=numbers {} 2>/dev/null || cat {}'
PREVIEW_GREP='bat --color=always --style=numbers --highlight-line {2} {1} 2>/dev/null || cat {1}'

HEADER='enter: open · ctrl-n: new · ctrl-f: text search · ctrl-d: delete · ctrl-/: preview'

clean_path() {
  echo "$1" | \
    tr -d '\n\r' | \
    sed 's/[<>:"|?*\\]//g' | \
    sed 's|\.\.|.|g' | \
    sed 's/[[:space:]]\+/-/g' | \
    sed 's/--*/-/g' | \
    sed 's|//*|/|g' | \
    sed 's|^[-./]*||; s|[-./ ]*$||'
}

strip_ansi() {
  sed 's/\x1b\[[0-9;]*[a-zA-Z]//g'
}

open_note() {
  local path="$1" line="${2:-}" name
  name=$(basename "$path" .md)
  local -a cmd=("$EDITOR")
  [[ -n "$line" ]] && cmd+=("+$line")
  cmd+=("$NOTES_DIR/$path")

  if [[ -n "${TMUX:-}" ]]; then
    tmux new-window -n "📝$name" "${cmd[@]}"
  else
    exec "${cmd[@]}"
  fi
}

mode="name"
query=""

while :; do
  if [[ "$mode" == "name" ]]; then
    result=$(
      eval "$LIST_CMD" |
        fzf --prompt="📝 Notes > " \
            --query="$query" \
            --print-query \
            --expect=ctrl-n,ctrl-f \
            --header="$HEADER" \
            --preview="$PREVIEW_FILE" \
            --preview-window='right:60%:wrap' \
            --bind='ctrl-/:toggle-preview' \
            --bind="ctrl-d:execute@printf '\ndelete %s ? [y/N] ' {} && read -r ans && [ \"\$ans\" = y ] && $DELETE_CMD {}@+reload($LIST_CMD)"
    )
  else
    result=$(
      fzf --prompt="🔍 Text > " \
          --query="$query" \
          --print-query \
          --expect=ctrl-n,ctrl-f \
          --ansi \
          --disabled \
          --delimiter=: \
          --header="$HEADER" \
          --bind="start:reload:$RG_CMD -- {q} . || true" \
          --bind="change:reload:sleep 0.1; $RG_CMD -- {q} . || true" \
          --preview="$PREVIEW_GREP" \
          --preview-window='right:60%:wrap:+{2}/2' \
          --bind='ctrl-/:toggle-preview' \
          --bind="ctrl-d:execute@printf '\ndelete %s ? [y/N] ' {1} && read -r ans && [ \"\$ans\" = y ] && $DELETE_CMD {1}@"
    )
  fi
  status=$?

  # esc / ctrl-c
  [[ $status -eq 130 ]] && exit 0

  mapfile -t lines <<< "$(strip_ansi <<< "$result")"
  query="${lines[0]:-}"
  key="${lines[1]:-}"
  selected="${lines[2]:-}"

  if [[ "$key" == "ctrl-f" ]]; then
    [[ "$mode" == "name" ]] && mode="grep" || mode="name"
    continue
  fi
  break
done

# open existing note
if [[ "$key" != "ctrl-n" && -n "$selected" ]]; then
  if [[ "$mode" == "grep" ]]; then
    file="${selected%%:*}"
    line="${selected#*:}"; line="${line%%:*}"
    [[ "$line" =~ ^[0-9]+$ ]] || line=""
    open_note "$file" "$line"
  else
    open_note "$selected"
  fi
  exit 0
fi

# create new note: ctrl-n, or enter with no matches
if [[ -n "$query" ]]; then
  name=$(clean_path "$query")
  [[ -z "$name" ]] && name="note-$(date +%Y%m%d-%H%M%S)"

  filepath="${name}.md"

  # keep everything inside NOTES_DIR
  case "$(realpath -m "$filepath")" in
    "$(realpath -m "$NOTES_DIR")"/*) ;;
    *) echo "⚠️ Path escapes $NOTES_DIR" >&2; exit 1 ;;
  esac

  mkdir -p "$(dirname "$filepath")"

  # never clobber an existing note
  if [[ ! -e "$filepath" ]]; then
    title="${query//\"/\\\"}"
    cat > "$filepath" <<EOF
---
title: "${title}"
date: $(date -Iseconds)
tags: []
---

# ${query}

EOF
  fi

  open_note "$filepath"
  exit 0
fi

echo "⚠️ No file name" >&2
exit 1
