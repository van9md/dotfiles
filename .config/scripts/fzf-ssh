#!/usr/bin/env bash

SSH_CONFIG="$HOME/.ssh/config"

if [[ $# -eq 1 ]]; then
    selected=$1
else
    if [[ ! -r "$SSH_CONFIG" ]]; then
        echo "⚠️ No $SSH_CONFIG" >&2
        exit 1
    fi
    selected=$(grep -E "^Host " "$SSH_CONFIG" | grep -v "#" | sed "s/^Host //" | tr " " "\n" | grep -v "^$" | grep -v "[*?]" | sort -u | fzf)
fi

if [[ -z "$selected" ]]; then
    exit 0
fi

# вне tmux открывать окно некуда — подключаемся прямо здесь
if [[ -n "$TMUX" ]]; then
    tmux new-window -n "🔌$selected" ssh "$selected"
else
    exec ssh "$selected"
fi
