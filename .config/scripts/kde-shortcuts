#!/usr/bin/env bash
# Глобальные хоткеи KDE Plasma 6 — восстановление на новой машине.
#
# Хранится скриптом, а не копией ~/.config/kglobalshortcutsrc: тем файлом
# владеет Plasma — она переписывает его целиком при правке через GUI, тащит
# внутрь UUID активностей и дефолты своей конкретной версии.
#
# Формат значения: "активная,дефолтная,описание". Несколько привязок к одному
# действию разделяются табом, поэтому такие строки идут как $'...\t...'.
# Хоткей с запятой (Meta+,) отсюда задать нельзя — запятая разделяет поля.
set -uo pipefail

command -v kwriteconfig6 >/dev/null 2>&1 || {
  echo "нужен kwriteconfig6 (пакет kf6-kconfig)" >&2
  exit 1
}

sc() {
  kwriteconfig6 --file kglobalshortcutsrc --group "$1" --key "$2" "$3"
}

# --- рабочие столы: Meta+N перейти, Meta+Shift+N утащить туда окно ---------
sc kwin 'Switch to Desktop 1' $'Meta+1,Ctrl+F1\tMeta+F1,Switch to Desktop 1'
sc kwin 'Switch to Desktop 2' $'Meta+2,Ctrl+F2\tMeta+F2,Switch to Desktop 2'
sc kwin 'Switch to Desktop 3' $'Meta+3,Ctrl+F3\tMeta+F3,Switch to Desktop 3'
sc kwin 'Switch to Desktop 4' $'Meta+4,Ctrl+F4\tMeta+F4,Switch to Desktop 4'
sc kwin 'Switch to Desktop 5' 'Meta+5,none,Switch to Desktop 5'
sc kwin 'Switch to Desktop 6' 'Meta+6,none,Switch to Desktop 6'

# Meta+Shift+цифра приходит в KWin как символ верхнего регистра
sc kwin 'Window to Desktop 1' 'Meta+!,none,Window to Desktop 1'
sc kwin 'Window to Desktop 2' 'Meta+@,none,Window to Desktop 2'
sc kwin 'Window to Desktop 3' 'Meta+#,none,Window to Desktop 3'
sc kwin 'Window to Desktop 4' 'Meta+$,none,Window to Desktop 4'
sc kwin 'Window to Desktop 5' 'Meta+%,none,Window to Desktop 5'
sc kwin 'Window to Desktop 6' 'Meta+^,none,Window to Desktop 6'
sc kwin 'Window to Desktop 7' 'Meta+&,none,Window to Desktop 7'

# --- окна ------------------------------------------------------------------
sc kwin 'Window Fullscreen' 'Meta+F,none,Make Window Fullscreen'
sc kwin 'Window Close' $'Alt+F4\tMeta+Shift+Q,Alt+F4,Close Window'
# Meta+D снят с "показать рабочий стол" — висит на запуске KRunner
sc kwin 'Show Desktop' 'none,Meta+D,Peek at Desktop'

# Meta-дубли сняты, чтобы не конфликтовать с раскладкой рабочих столов выше
sc kwin 'Expose' $'Ctrl+F9,Ctrl+F9\tMeta+F9,Toggle Present Windows (Current desktop)'
sc kwin 'ExposeAll' $'Launch (C)\tCtrl+F10,Launch (C)\tCtrl+F10\tMeta+F10,Toggle Present Windows (All desktops)'
sc kwin 'ExposeClass' $'Ctrl+F7,Ctrl+F7\tMeta+F7,Toggle Present Windows (Window class)'
sc kwin 'Walk Through Windows' $'Alt+Tab,Alt+Tab\tMeta+Tab,Walk Through Windows'
sc kwin 'Walk Through Windows (Reverse)' $'Alt+Shift+Tab,Alt+Shift+Tab\tMeta+Shift+Tab,Walk Through Windows (Reverse)'
sc kwin 'Walk Through Windows of Current Application' $'Alt+`,Alt+`\tMeta+`,Walk Through Windows of Current Application'
sc kwin 'Walk Through Windows of Current Application (Reverse)' $'Alt+~,Alt+~\tMeta+~,Walk Through Windows of Current Application (Reverse)'

# --- оболочка --------------------------------------------------------------
sc plasmashell 'activate application launcher' $'Meta+S,Meta\tAlt+F1,Activate Application Launcher'
# Meta+1..6 отобраны у панели задач и отданы рабочим столам
for i in 1 2 3 4 5 6; do
  sc plasmashell "activate task manager entry $i" "none,Meta+$i,Activate Task Manager Entry $i"
done
sc plasmashell 'previous activity' 'Meta+Shift+A,none,Walk through activities (Reverse)'

sc ksmserver 'Shut Down' 'Meta+Shift+P,none,Shut Down'
sc 'KDE Keyboard Layout Switcher' 'Switch to Next Keyboard Layout' \
  'Alt+Shift,Meta+Alt+K,Switch to Next Keyboard Layout'

# --- музыка (MPRIS) --------------------------------------------------------
# Ходит в ту же шину, что и tmux-now-playing в строке статуса tmux.
sc mediacontrol playpausemedia $'Media Play\tMeta+M,Media Play,Play/Pause media playback'
sc mediacontrol nextmedia $'Media Next\tMeta+],Media Next,Media playback next'
sc mediacontrol previousmedia $'Media Previous\tMeta+[,Media Previous,Media playback previous'

# Активности привязаны к UUID конкретной инсталляции, переносить их нет смысла —
# на новой машине назначается руками:
#   sc ActivityManager 'switch-to-activity-<UUID>' 'Meta+F2,none,Switch to activity "Coding"'

echo "хоткеи записаны в ~/.config/kglobalshortcutsrc"
echo "KWin подхватит их после перезахода в сессию"
